# Adresse de l'API backend (Laravel), lue par src/constants/config.ts.
# Doit obligatoirement inclure le préfixe /api/v1.
#
# Copier ce fichier en .env.local et choisir UNE des options ci-dessous.
#
# Option A — test sur navigateur (expo start --web) depuis cette machine :
# EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
#
# Option B — test sur téléphone (Expo Go), même Wi-Fi que le PC :
#   1. Backend lancé sur toutes les interfaces : php artisan serve --host=0.0.0.0 --port=8000
#   2. Remplacer par l'IP LAN de la machine (`ipconfig`) — elle change en DHCP.
# EXPO_PUBLIC_API_URL=http://192.168.1.2:8000/api/v1
#
# Option C — tunnel public (ngrok/cloudflared), si le téléphone n'est pas sur le
# même réseau. URL changeante à chaque session.
# EXPO_PUBLIC_API_URL=https://xxxx-xx-xx.ngrok-free.app/api/v1

EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
